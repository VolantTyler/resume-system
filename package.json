    "judge": "tsx scripts/judge-resume.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nunjucks": "^3.2.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "nunjucks": "^3.2.4",
    "puppeteer-core": "^25.3.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  }
