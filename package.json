{
  "name": "resume-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "tsx scripts/validate-resume-data.ts",
    "generate": "tsx scripts/generate-all.ts",
    "generate:pdf": "tsx scripts/generate-pdf.ts",
    "generate:portfolio": "tsx scripts/generate-portfolio-json.ts",
    "build": "npm run validate && npm run generate",
