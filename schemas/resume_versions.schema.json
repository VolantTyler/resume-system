{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "resume_versions.schema.json",
  "title": "Resume Versions",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "target_id",
      "label",
      "summary_variant",
      "experience_ids",
      "accomplishment_ids",
      "output_slug"
    ],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "target_id": { "type": "string", "minLength": 1 },
      "label": { "type": "string", "minLength": 1 },
      "summary_variant": { "type": "string", "minLength": 1 },
      "experience_ids": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "accomplishment_ids": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1
      },
      "project_ids": { "type": "array", "items": { "type": "string" } },
      "skill_emphasis": { "type": "array", "items": { "type": "string" } },
      "application_fit": {
        "type": "object",
        "required": ["overall", "strengths", "weaknesses"],
        "properties": {
          "role_reference": { "type": "string", "minLength": 1 },
          "overall": { "type": "string", "minLength": 1 },
          "strengths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["criterion", "resume_reference"],
              "properties": {
                "criterion": { "type": "string", "minLength": 1 },
                "resume_reference": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "weaknesses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["criterion", "indirect_address"],
              "properties": {
                "criterion": { "type": "string", "minLength": 1 },
                "indirect_address": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "output_folder": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "description": "Subfolder under output/resumes/ for employer or category grouping (e.g. deloitte, frontend)."
      },
      "output_slug": { "type": "string", "minLength": 1 },
      "revision_history": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["date", "note"],
          "properties": {
            "date": { "type": "string" },
            "note": { "type": "string" }
          }
        }
      }
    },
    "additionalProperties": false
  }
}
