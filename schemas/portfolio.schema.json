{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "portfolio.schema.json",
  "title": "Portfolio Content",
  "description": "Output contract for output/portfolio/resume-content.json, generated by `npm run generate` (scripts/generate-portfolio-json.ts) for consumption by tylerstahl.dev or another portfolio site. This file documents the shape; it is not enforced automatically at generation time.",
  "type": "object",
  "required": [
    "name",
    "headline",
    "summary",
    "featuredProjects",
    "skills",
    "experience",
    "selectedAccomplishments",
    "generatedAt",
    "versionId",
    "targetId"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "location": { "type": "string" },
    "portfolioUrl": { "type": "string", "format": "uri" },
    "githubUrl": { "type": "string", "format": "uri" },
    "linkedinUrl": { "type": "string", "format": "uri" },
    "summary": { "type": "string", "minLength": 1 },
    "featuredProjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "organization", "technologies", "outcomes", "portfolioVisible"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "organization": { "type": "string" },
          "timeframe": { "type": "string" },
          "problem": { "type": "string" },
          "solution": { "type": "string" },
          "technologies": { "type": "array", "items": { "type": "string" } },
          "outcomes": { "type": "array", "items": { "type": "string" } },
          "portfolioVisible": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "items"],
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "items": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "company", "title", "startDate", "endDate", "technologies", "bullets"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "company": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "location": { "type": "string" },
          "startDate": { "type": "string" },
          "endDate": { "type": "string" },
          "summary": { "type": "string" },
          "technologies": { "type": "array", "items": { "type": "string" } },
          "bullets": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "selectedAccomplishments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "bullet", "themes", "technologies", "confidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "company": { "type": "string" },
          "timeframe": { "type": "string" },
          "bullet": { "type": "string", "minLength": 1 },
          "themes": { "type": "array", "items": { "type": "string" } },
          "technologies": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        },
        "additionalProperties": false
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["institution", "credential"],
        "properties": {
          "institution": { "type": "string", "minLength": 1 },
          "credential": { "type": "string", "minLength": 1 },
          "note": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "versionId": { "type": "string", "minLength": 1 },
    "targetId": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
